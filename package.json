{
  "name": "advanced-new-tab",
  "version": "1.0.0",
  "description": "A browser-like search tab for your local files.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit --skipLibCheck && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src --max-warnings 0",
    "release:check": "node scripts/check-release.mjs"
  },
  "keywords": [],
  "author": "everydaymind",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.25.12",
    "esbuild-svelte": "0.8.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-svelte": "2.46.1",
    "jsdom": "26.1.0",
    "obsidian": "1.13.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "svelte-preprocess": "5.1.4",
    "tslib": "2.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "fuse.js": "^6.6.2"
  },
  "overrides": {
    "moment": "2.31.0",
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
